# Copy this file to .env and fill in your keys:  cp .env.example .env
# .env is gitignored — never commit real keys.

# --- Model provider (at least one) ---------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: force a provider ("anthropic" | "openai" | "ollama") and/or a model name.
# Defaults: Anthropic if ANTHROPIC_API_KEY is set (claude-sonnet-5-5), else OpenAI (gpt-5-mini).
# Ollama is never picked automatically; set MODEL_PROVIDER=ollama to use it.
# MODEL_PROVIDER=anthropic
# MODEL_NAME=claude-sonnet-5-5   # Anthropic / OpenAI only; Ollama uses OLLAMA_MODEL

# --- Local models via Ollama (optional, no key needed) --------------------
# ollama pull qwen3:8b   then uncomment MODEL_PROVIDER=ollama.
# MODEL_PROVIDER=ollama
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434
# Thinking models (qwen3...): off by default so answers stay clean.
# "true" keeps the thinking but puts it in additional_kwargs["reasoning_content"];
# "low" | "medium" | "high" set an effort level on models that support it.
# OLLAMA_REASONING=false

# --- LangSmith tracing (optional) ----------------------------------------
# Free account at https://smith.langchain.com — every chain/graph run becomes
# an inspectable trace (inputs, outputs, latency, tokens) when enabled.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-playground
