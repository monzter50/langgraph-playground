# Copy this file to .env and fill in your keys:  cp .env.example .env
# .env is gitignored — never commit real keys.

# --- Model provider (at least one) ---------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: force a provider ("anthropic" | "openai") and/or a model name.
# Defaults: Anthropic if ANTHROPIC_API_KEY is set (claude-sonnet-5-5), else OpenAI (gpt-5-mini).
# MODEL_PROVIDER=anthropic
# MODEL_NAME=claude-sonnet-5-5

# --- LangSmith tracing (optional) ----------------------------------------
# Free account at https://smith.langchain.com — every chain/graph run becomes
# an inspectable trace (inputs, outputs, latency, tokens) when enabled.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-playground
